# Supabase (crie um projeto em https://supabase.com e copie de Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # somente servidor — NUNCA expor no cliente

# PostgreSQL (Settings → Database → Connection string)
DATABASE_URL=                      # pooled (pgbouncer), usado pelo Prisma Client
DIRECT_URL=                        # conexão direta, usada pelas migrations

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
